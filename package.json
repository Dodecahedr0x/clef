{
  "name": "clef",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "test": "vitest run --project unit --project unit-dom",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && pnpm --filter @clef/extension typecheck",
    "clef": "tsx apps/cli/src/main.ts",
    "build:ext": "pnpm --filter @clef/extension build",
    "e2e": "pnpm build:ext && playwright test",
    "test:local": "vitest run --project local",
    "test:live": "vitest run --project live",
    "zip:ext": "tsx scripts/zip-extension.ts",
    "icons": "tsx scripts/icons.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "screenshots:store": "CLEF_SCREENSHOTS=1 playwright test e2e/store-screenshots.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.9.3"
    }
  }
}
